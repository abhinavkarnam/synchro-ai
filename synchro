  <!-- SCRIPT: ENGINE & INTERACTIVE TWIN          -->
  <!-- ========================================== -->
  <script>
    // --- VIJAYANAGAR NODES (GEOGRAPHICALLY ACCURATE) ---
    const nodes = [
      { id: 'bescom_rpc', name: 'BESCOM RPC Substation', type: 'power', x: 220, y: 260, load: 64, status: 'nominal', label: '66/11kV Substation' },
      { id: 'vjy_metro_ttmc', name: 'Vijayanagar TTMC & Metro', type: 'traffic', x: 440, y: 220, load: 48, status: 'nominal', label: 'Traffic & Transit Hub' },
      { id: 'maruti_mandir_jn', name: 'Maruti Mandir Jn', type: 'traffic', x: 580, y: 260, load: 45, status: 'nominal', label: 'Pipeline Rd Crossing' },
      { id: 'bwssb_glr', name: 'BWSSB Vijayanagar GLR', type: 'water', x: 380, y: 340, load: 65, status: 'nominal', label: 'Ground Reservoir' },
      { id: 'bgs_hospital', name: 'BGS Gleneagles Hospital', type: 'emergency', x: 490, y: 410, load: 42, status: 'nominal', label: 'Level-1 Trauma Care' },
      { id: 'tollgate_magadi', name: 'Magadi Rd Toll Gate', type: 'traffic', x: 620, y: 100, load: 52, status: 'nominal', label: 'North Entrance' }
    ];

    // Arterial road paths
    const roads = [
      // West of Chord Road (Main spine running through TTMC)
      { name: 'West of Chord Road', points: [{x: 440, y: 40}, {x: 440, y: 220}, {x: 460, y: 350}, {x: 480, y: 480}], speed: 38, status: 'fluid' },
      // Pipeline Road (Running east-west across Vijayanagar)
      { name: 'Vijayanagar Pipeline Road', points: [{x: 100, y: 260}, {x: 220, y: 260}, {x: 440, y: 240}, {x: 580, y: 260}, {x: 740, y: 260}], speed: 36, status: 'fluid' },
      // Magadi Road
      { name: 'Magadi Road', points: [{x: 280, y: 70}, {x: 460, y: 85}, {x: 620, y: 100}, {x: 750, y: 110}], speed: 35, status: 'fluid' },
      // Hospital Corridor
      { name: '17th Cross Hospital Link', points: [{x: 440, y: 220}, {x: 490, y: 410}], speed: 40, status: 'fluid' }
    ];

    // Colors
    const typeColors = {
      power: '#f59e0b',
      traffic: '#06b6d4',
      water: '#10b981',
      emergency: '#f43f5e'
    };

    let activeScenario = null;
    let currentTimelineStep = 0;
    let isMitigated = false;
    let autoPilotActive = false;
    let autoPilotStep = 0;
    let autoPilotTimer = null;

    // Traffic particles
    let particles = [];
    function initParticles() {
      particles = [];
      roads.forEach((road, rIdx) => {
        for (let i = 0; i < 6; i++) {
          particles.push({
            roadIndex: rIdx,
            progress: i / 6,
            speed: 0.003
          });
        }
      });
    }

    // --- CANVAS RENDERING (CLEAN, SHARP, ATTRACTIVE) ---
    const canvas = document.getElementById('twinCanvas');
    const ctx = canvas.getContext('2d');

    function resizeCanvas() {
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * window.devicePixelRatio;
      canvas.height = rect.height * window.devicePixelRatio;
      ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
    }
    window.addEventListener('resize', resizeCanvas);

    function getInterpolatedPoint(points, t) {
      if (points.length === 2) {
        return {
          x: points[0].x + (points[1].x - points[0].x) * t,
          y: points[0].y + (points[1].y - points[0].y) * t
        };
      }
      const segmentCount = points.length - 1;
      const seg = Math.min(Math.floor(t * segmentCount), segmentCount - 1);
      const subT = (t * segmentCount) - seg;
      const p1 = points[seg];
      const p2 = points[seg + 1];
      return {
        x: p1.x + (p2.x - p1.x) * subT,
        y: p1.y + (p2.y - p1.y) * subT
      };
    }

    function renderMap() {
      const rect = canvas.getBoundingClientRect();
      const w = rect.width;
      const h = rect.height;

      // Scale factors from virtual 800x520 space
      const sx = w / 800;
      const sy = h / 520;

      ctx.clearRect(0, 0, w, h);

      // Clean, attractive dark backdrop
      ctx.fillStyle = '#0a0f1d';
      ctx.fillRect(0, 0, w, h);

      // Subtle neighborhood area zones
      ctx.fillStyle = 'rgba(15, 23, 42, 0.45)';
      ctx.beginPath();
      ctx.roundRect(40 * sx, 30 * sy, 240 * sx, 180 * sy, 20);
      ctx.fill();
      ctx.fillStyle = 'rgba(148, 163, 184, 0.2)';
      ctx.font = '600 11px Plus Jakarta Sans';
      ctx.fillText('RPC LAYOUT', 55 * sx, 55 * sy);

      ctx.fillStyle = 'rgba(15, 23, 42, 0.45)';
      ctx.beginPath();
      ctx.roundRect(520 * sx, 280 * sy, 240 * sx, 180 * sy, 20);
      ctx.fill();
      ctx.fillStyle = 'rgba(148, 163, 184, 0.2)';
      ctx.fillText('ATTIGUPPE / CHORD RD', 535 * sx, 305 * sy);

      // Draw Roads
      roads.forEach(road => {
        let roadColor = '#10b981'; // Fluid green
        let roadWidth = 8;
        let glowColor = 'rgba(16, 185, 129, 0.25)';

        if (road.status === 'gridlock') {
          roadColor = '#ef4444'; // Red
          glowColor = 'rgba(239, 68, 68, 0.45)';
          roadWidth = 9;
        } else if (road.status === 'slow') {
          roadColor = '#f59e0b'; // Amber
          glowColor = 'rgba(245, 158, 11, 0.35)';
          roadWidth = 8.5;
        }

        // Road base shadow
        ctx.beginPath();
        road.points.forEach((pt, idx) => {
          if (idx === 0) ctx.moveTo(pt.x * sx, pt.y * sy);
          else ctx.lineTo(pt.x * sx, pt.y * sy);
        });
        ctx.strokeStyle = '#1e293b';
        ctx.lineWidth = roadWidth + 6;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.stroke();

        // Glowing road line
        ctx.beginPath();
        road.points.forEach((pt, idx) => {
          if (idx === 0) ctx.moveTo(pt.x * sx, pt.y * sy);
          else ctx.lineTo(pt.x * sx, pt.y * sy);
        });
        ctx.strokeStyle = glowColor;
        ctx.lineWidth = roadWidth + 4;
        ctx.stroke();

        // Inner core road
        ctx.beginPath();
        road.points.forEach((pt, idx) => {
          if (idx === 0) ctx.moveTo(pt.x * sx, pt.y * sy);
          else ctx.lineTo(pt.x * sx, pt.y * sy);
        });
        ctx.strokeStyle = roadColor;
        ctx.lineWidth = roadWidth;
        ctx.stroke();

        // Road label
        const midPoint = road.points[Math.floor(road.points.length / 2)];
        ctx.fillStyle = '#94a3b8';
        ctx.font = '700 10px Plus Jakarta Sans';
        ctx.fillText(road.name, midPoint.x * sx + 8, midPoint.y * sy - 8);
      });

      // Animated traffic particles
      particles.forEach(p => {
        const road = roads[p.roadIndex];
        const pt = getInterpolatedPoint(road.points, p.progress);
        
        let pColor = '#ffffff';
        if (road.status === 'gridlock') pColor = '#fca5a5';
        else if (road.status === 'slow') pColor = '#fde68a';

        ctx.beginPath();
        ctx.arc(pt.x * sx, pt.y * sy, 3, 0, Math.PI * 2);
        ctx.fillStyle = pColor;
        ctx.shadowColor = pColor;
        ctx.shadowBlur = 6;
        ctx.fill();
        ctx.shadowBlur = 0;

        let speed = road.status === 'gridlock' ? 0.0006 : road.status === 'slow' ? 0.0018 : 0.004;
        p.progress += speed;
        if (p.progress > 1) p.progress = 0;
      });

      // Dependency lines between nodes
      ctx.strokeStyle = 'rgba(56, 189, 248, 0.2)';
      ctx.lineWidth = 1.5;
      ctx.setLineDash([4, 4]);
      // BESCOM to TTMC & GLR
      ctx.beginPath();
      ctx.moveTo(220 * sx, 260 * sy);
      ctx.lineTo(440 * sx, 220 * sy);
      ctx.lineTo(380 * sx, 340 * sy);
      ctx.lineTo(490 * sx, 410 * sy);
      ctx.stroke();
      ctx.setLineDash([]);

      // Draw Nodes
      nodes.forEach(node => {
        const color = typeColors[node.type];
        const isCritical = node.status === 'critical';
        const isWarning = node.status === 'warning';
        const isMitigatedNode = node.status === 'mitigated';

        let nodeColor = color;
        if (isCritical) nodeColor = '#ef4444';
        else if (isWarning) nodeColor = '#f59e0b';
        else if (isMitigatedNode) nodeColor = '#10b981';

        const nx = node.x * sx;
        const ny = node.y * sy;

        // Critical pulse ring
        if (isCritical) {
          ctx.beginPath();
          ctx.arc(nx, ny, 24 + Math.sin(Date.now() / 200) * 4, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(239, 68, 68, 0.25)';
          ctx.fill();
        }

        // Node circle
        ctx.beginPath();
        ctx.arc(nx, ny, 10, 0, Math.PI * 2);
        ctx.fillStyle = '#0f172a';
        ctx.fill();
        ctx.strokeStyle = nodeColor;
        ctx.lineWidth = 3.5;
        ctx.stroke();

        // Inner glowing core
        ctx.beginPath();
        ctx.arc(nx, ny, 4, 0, Math.PI * 2);
        ctx.fillStyle = nodeColor;
        ctx.fill();

        // Node Badge Label
        ctx.fillStyle = 'rgba(15, 23, 42, 0.9)';
        ctx.beginPath();
        const textW = ctx.measureText(node.name).width + 16;
        ctx.roundRect(nx - textW / 2, ny + 15, textW, 20, 6);
        ctx.fill();
        ctx.strokeStyle = nodeColor + '80';
        ctx.lineWidth = 1;
        ctx.stroke();

        ctx.fillStyle = '#ffffff';
        ctx.font = '800 10.5px Plus Jakarta Sans';
        ctx.textAlign = 'center';
        ctx.fillText(node.name, nx, ny + 29);
        ctx.textAlign = 'start';
      });

      requestAnimationFrame(renderMap);
    }

    // Node click handler
    canvas.addEventListener('click', (e) => {
      const rect = canvas.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const clickY = e.clientY - rect.top;
      const sx = rect.width / 800;
      const sy = rect.height / 520;

      nodes.forEach(node => {
        const nx = node.x * sx;
        const ny = node.y * sy;
        const dist = Math.hypot(clickX - nx, clickY - ny);
        if (dist < 25) {
          handleNodeClick(node.id);
        }
      });
    });

