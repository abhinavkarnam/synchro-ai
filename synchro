    let currentSlide = 0;
    function openSlideDeck() {
      currentSlide = 0;
      renderSlide();
      document.getElementById('slides-modal').classList.remove('hidden');
    }
    function closeSlideDeck() {
      document.getElementById('slides-modal').classList.add('hidden');
    }
    function renderSlide() {
      const slide = slideDeckData[currentSlide];
      document.getElementById('slide-number-indicator').textContent = `Slide ${currentSlide + 1} / ${slideDeckData.length}`;
      document.getElementById('slide-content').innerHTML = `
        <h3 class="text-2xl font-black text-white">${slide.title}</h3>
        <p class="text-xs text-cyan-400 font-semibold mt-1">${slide.subtitle}</p>
        <div class="mt-4">${slide.body}</div>
      `;
      const dots = document.getElementById('slide-dots');
      dots.innerHTML = slideDeckData.map((_, i) => `
        <div class="w-2.5 h-2.5 rounded-full ${i === currentSlide ? 'bg-cyan-400 w-6' : 'bg-slate-700'} transition-all"></div>
      `).join('');
      lucide.createIcons();
    }
    function nextSlide() {
      if (currentSlide < slideDeckData.length - 1) {
        currentSlide++;
        renderSlide();
      } else {
        closeSlideDeck();
      }
    }
    function prevSlide() {
      if (currentSlide > 0) {
        currentSlide--;
        renderSlide();
      }
    }

    // --- INITIALIZE ON WINDOW LOAD ---
    window.onload = () => {
      resizeCanvas();
      initParticles();
      renderMap();
      lucide.createIcons();

      setInterval(() => {
        const timeEl = document.getElementById('live-time');
        if (timeEl) timeEl.textContent = new Date().toLocaleTimeString() + ' IST';
      }, 1000);
    };
