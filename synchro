<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SynchroCity AI - Vijayanagar Infrastructure & Traffic Twin</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            cyber: {
              bg: '#0a0e17',
              surface: '#0f172a',
              card: '#141e33',
              border: '#1e293b',
              accent: '#38bdf8',
              power: '#f59e0b',
              traffic: '#06b6d4',
              water: '#10b981',
              emergency: '#f43f5e',
              ai: '#a855f7'
            }
          }
        }
      }
    }
  </script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
    
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: radial-gradient(circle at 50% 20%, #111827 0%, #070a12 100%);
      color: #f1f5f9;
      min-height: 100vh;
      overflow-x: hidden;
      user-select: none;
    }

    .mono { font-family: 'JetBrains Mono', monospace; }

    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: #0b0f19; }
    ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 4px; }

    .card-panel {
      background: rgba(17, 24, 39, 0.75);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    }

    /* Animated pulse ring for critical nodes */
    @keyframes pulseRing {
      0% { transform: scale(0.8); opacity: 1; }
      100% { transform: scale(2.2); opacity: 0; }
    }
    .pulse-ring {
      animation: pulseRing 1.8s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
    }

    /* Toast animation */
    @keyframes slideDown {
      from { transform: translateY(-40px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    .toast-slide {
      animation: slideDown 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Shimmer effect for buttons */
    @keyframes shimmer {
      0% { background-position: -200% 0; }
      100% { background-position: 200% 0; }
    }
    .btn-shimmer {
      background-size: 200% auto;
      animation: shimmer 4s linear infinite;
    }
  </style>
</head>
<body class="flex flex-col min-h-screen text-slate-100">

  <!-- ========================================== -->
  <!-- FLOATING INCOMING CITIZEN REPORT TOAST     -->
  <!-- ========================================== -->
  <div id="admin-incident-toast" class="hidden fixed top-20 right-6 z-50 max-w-md w-full bg-slate-900/95 border-2 border-emerald-500 rounded-2xl p-4 shadow-2xl backdrop-blur-xl toast-slide">
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-start gap-3">
        <div class="h-10 w-10 rounded-xl bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400 shrink-0 animate-bounce">
          <i data-lucide="bell-ring" class="w-5 h-5"></i>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="text-xs font-black uppercase text-emerald-400">Citizen Ground Report</span>
            <span id="toast-inc-id" class="text-[10px] mono bg-slate-800 px-1.5 py-0.5 rounded text-slate-300">#VJY-4891</span>
          </div>
          <h4 id="toast-inc-title" class="font-bold text-sm text-white mt-0.5">Burst Cauvery Water Main</h4>
          <p id="toast-inc-desc" class="text-xs text-slate-300 line-clamp-1 mt-0.5">Vijayanagar Pipeline Road · Maruti Mandir Jn</p>
        </div>
      </div>
      <button onclick="dismissToast()" class="text-slate-400 hover:text-white p-1">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>
    
    <div class="mt-3 pt-3 border-t border-slate-800 flex items-center justify-between">
      <span class="text-[10px] text-slate-400 flex items-center gap-1">
        <i data-lucide="camera" class="w-3 h-3 text-cyan-400"></i> Photo Attached &bull; Vijayanagar Ward 123
      </span>
      <button onclick="openVerificationFromToast()" class="px-3 py-1.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold text-xs shadow-md transition flex items-center gap-1.5 cursor-pointer">
        <i data-lucide="scan" class="w-3.5 h-3.5"></i> Inspect & Verify
      </button>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- TOP APP BAR                                -->
  <!-- ========================================== -->
  <header class="border-b border-slate-800/80 bg-slate-950/80 backdrop-blur-md sticky top-0 z-40 px-5 py-3 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="h-10 w-10 rounded-xl bg-gradient-to-tr from-cyan-500 via-indigo-600 to-purple-600 flex items-center justify-center shadow-lg shadow-cyan-500/20">
        <i data-lucide="network" class="w-5 h-5 text-white"></i>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xl font-extrabold tracking-tight bg-gradient-to-r from-white via-slate-200 to-cyan-400 bg-clip-text text-transparent">SynchroCity AI</span>
          <span class="px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">Vijayanagar Sector</span>
        </div>
        <p class="text-[11px] text-slate-400">Autonomous Cross-Infrastructure Digital Twin &bull; Bengaluru West</p>
      </div>
    </div>

    <!-- Quick Status Badges -->
    <div class="hidden lg:flex items-center gap-6 text-xs">
      <div class="flex items-center gap-2">
        <div id="vitals-status-dot" class="h-2.5 w-2.5 rounded-full bg-emerald-500 animate-ping"></div>
        <span class="text-slate-400">System State:</span>
        <span id="vitals-status-badge" class="font-bold px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">EQUILIBRIUM</span>
      </div>
      <div class="h-4 w-px bg-slate-800"></div>
      <div>
        <span class="text-slate-400">Sector:</span>
        <span class="font-semibold text-slate-200 ml-1">West of Chord &bull; Pipeline Rd</span>
      </div>
    </div>

    <!-- Top Action Buttons -->
    <div class="flex items-center gap-2">
      <!-- Citizen Portal Link -->
      <a href="citizen.html" target="_blank" class="px-3 py-1.5 text-xs font-bold rounded-xl bg-slate-800 hover:bg-slate-700 text-emerald-300 border border-emerald-500/30 transition flex items-center gap-1.5">
        <i data-lucide="external-link" class="w-3.5 h-3.5 text-emerald-400"></i>
        <span>Citizen Portal</span>
      </a>

      <!-- Pending Reports -->
      <button onclick="openCitizenModal()" id="btn-admin-verify" class="relative px-3 py-1.5 text-xs font-bold rounded-xl bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-300 border border-emerald-500/40 transition flex items-center gap-1.5 cursor-pointer">
        <i data-lucide="camera" class="w-3.5 h-3.5 text-emerald-400"></i>
        <span>Citizen Reports</span>
        <span id="badge-incident-count" class="px-1.5 py-0.2 rounded-full text-[9px] bg-emerald-500 text-slate-950 font-black">1 Pending</span>
      </button>

      <!-- Audio Mute -->
      <button onclick="toggleAudio()" id="btn-audio" title="Toggle Sound FX" class="p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition cursor-pointer">
        <i id="audio-icon" data-lucide="volume-2" class="w-4 h-4 text-cyan-400"></i>
      </button>

      <!-- Pitch Slides -->
      <button onclick="openSlideDeck()" class="px-3 py-1.5 text-xs font-bold rounded-xl bg-slate-800 hover:bg-slate-700 text-cyan-300 border border-cyan-500/30 transition flex items-center gap-1.5 cursor-pointer">
        <i data-lucide="presentation" class="w-3.5 h-3.5 text-cyan-400"></i>
        <span class="hidden sm:inline">Slides</span>
      </button>

      <!-- Giant 60s Jury Demo Button -->
      <button onclick="toggleAutoPilot()" id="btn-autopilot" class="px-4 py-2 text-xs font-black rounded-xl bg-gradient-to-r from-purple-600 via-indigo-600 to-cyan-500 hover:from-purple-500 hover:to-cyan-400 text-white shadow-lg shadow-purple-500/30 transition flex items-center gap-2 cursor-pointer btn-shimmer">
        <i id="autopilot-icon" data-lucide="play" class="w-4 h-4 fill-white"></i>
        <span id="autopilot-text">▶ 60s Jury Presentation</span>
      </button>
    </div>
  </header>

  <!-- ========================================== -->
  <!-- JURY PRESENTATION BANNER (AUTO-PILOT)      -->
  <!-- ========================================== -->
  <div id="autopilot-banner" class="hidden bg-gradient-to-r from-purple-900/90 via-indigo-900/90 to-slate-900/90 border-b border-purple-500/40 px-6 py-2.5 flex items-center justify-between text-xs transition-all z-30 shadow-xl">
    <div class="flex items-center gap-3">
      <span class="px-2.5 py-0.5 rounded-full bg-purple-500/30 text-purple-200 font-extrabold uppercase text-[10px] tracking-wider animate-pulse flex items-center gap-1 border border-purple-400/40">
        <i data-lucide="radio" class="w-3 h-3"></i> Jury Demo In Progress
      </span>
      <span id="autopilot-caption" class="text-white font-semibold text-sm">Demonstrating cross-infrastructure cascading failure in Vijayanagar...</span>
    </div>
    <div class="flex items-center gap-3">
      <span id="autopilot-step-badge" class="mono text-cyan-300 text-xs font-bold">Step 1/5</span>
      <button onclick="stopAutoPilot()" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold">Exit Demo</button>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- 3 HERO KPI CARDS FOR JURY (MEMORABLE)     -->
  <!-- ========================================== -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5 px-5 pt-4 max-w-[1920px] mx-auto w-full">
    <!-- 1. Resilience -->
    <div class="card-panel p-4 rounded-2xl border border-slate-800 flex items-center justify-between">
      <div>
        <span class="text-xs text-slate-400 font-semibold uppercase tracking-wider block mb-1">Vijayanagar City Resilience</span>
        <div class="flex items-baseline gap-2">
          <span id="vitals-resilience" class="mono text-3xl font-black text-emerald-400">96.4%</span>
          <span id="resilience-tag" class="text-xs font-bold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full">Equilibrium</span>
        </div>
        <p class="text-[11px] text-slate-400 mt-1">Cross-system stability score across power, water, & traffic</p>
      </div>
      <div class="h-12 w-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
        <i data-lucide="shield-check" class="w-6 h-6"></i>
      </div>
    </div>

    <!-- 2. Traffic Flow -->
    <div class="card-panel p-4 rounded-2xl border border-slate-800 flex items-center justify-between">
      <div>
        <span class="text-xs text-slate-400 font-semibold uppercase tracking-wider block mb-1">West of Chord Road Arterial</span>
        <div class="flex items-baseline gap-2">
          <span id="vitals-traffic" class="mono text-3xl font-black text-cyan-400">38 km/h</span>
          <span id="traffic-tag" class="text-xs font-bold text-cyan-400 bg-cyan-500/10 px-2 py-0.5 rounded-full">Fluid Flow</span>
        </div>
        <p class="text-[11px] text-slate-400 mt-1">Vijayanagar TTMC & Metro corridor throughput</p>
      </div>
      <div class="h-12 w-12 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400">
        <i data-lucide="car" class="w-6 h-6"></i>
      </div>
    </div>

    <!-- 3. Emergency Trauma Response -->
    <div class="card-panel p-4 rounded-2xl border border-slate-800 flex items-center justify-between">
      <div>
        <span class="text-xs text-slate-400 font-semibold uppercase tracking-wider block mb-1">BGS Trauma Ambulance Clearway</span>
        <div class="flex items-baseline gap-2">
          <span id="vitals-emg" class="mono text-3xl font-black text-rose-400">4.2 min</span>
          <span id="emg-tag" class="text-xs font-bold text-rose-400 bg-rose-500/10 px-2 py-0.5 rounded-full">Optimal Priority</span>
        </div>
        <p class="text-[11px] text-slate-400 mt-1">Life-safety emergency corridor response time</p>
      </div>
      <div class="h-12 w-12 rounded-2xl bg-rose-500/10 border border-rose-500/20 flex items-center justify-center text-rose-400">
        <i data-lucide="ambulance" class="w-6 h-6"></i>
      </div>
    </div>
  </div>

  <!-- ========================================== -->
  <!-- MAIN APP GRID                              -->
  <!-- ========================================== -->
  <main class="flex-1 grid grid-cols-12 gap-4 p-4 lg:p-5 max-w-[1920px] mx-auto w-full">

    <!-- LEFT COLUMN: MAP & CONTROLS (8 Cols) -->
    <div class="col-span-12 xl:col-span-8 flex flex-col gap-4">

      <!-- SCENARIO & STRESS INJECTOR BAR -->
      <div class="card-panel p-3.5 rounded-2xl flex flex-wrap items-center justify-between gap-3 border border-slate-800 shadow-xl">
        <div class="flex items-center gap-2">
          <span class="text-xs uppercase font-extrabold tracking-wider text-slate-400 flex items-center gap-1.5">
            <i data-lucide="zap" class="w-4 h-4 text-amber-400"></i>
            Inject Crisis:
          </span>
          <div class="flex flex-wrap items-center gap-1.5">
            <button onclick="runScenario('flood')" id="btn-flood" class="px-3 py-1.5 text-xs font-bold rounded-xl bg-cyan-500/15 hover:bg-cyan-500/25 text-cyan-300 border border-cyan-500/40 transition flex items-center gap-1.5 cursor-pointer">
              <i data-lucide="cloud-rain" class="w-3.5 h-3.5 text-cyan-400"></i>
              Pipeline Road Water Rupture
            </button>
            <button onclick="runScenario('heatwave')" id="btn-heatwave" class="px-3 py-1.5 text-xs font-bold rounded-xl bg-amber-500/15 hover:bg-amber-500/25 text-amber-300 border border-amber-500/40 transition flex items-center gap-1.5 cursor-pointer">
              <i data-lucide="sun" class="w-3.5 h-3.5 text-amber-400"></i>
              BESCOM RPC Substation Overheat
            </button>
            <button onclick="runScenario('transit')" id="btn-transit" class="px-3 py-1.5 text-xs font-bold rounded-xl bg-purple-500/15 hover:bg-purple-500/25 text-purple-300 border border-purple-500/40 transition flex items-center gap-1.5 cursor-pointer">
              <i data-lucide="train" class="w-3.5 h-3.5 text-purple-400"></i>
              Vijayanagar TTMC Metro Gridlock
            </button>
          </div>
        </div>

        <!-- Timeline scrubber -->
        <div class="flex items-center gap-2">
          <span class="text-xs text-slate-400">Timeline:</span>
          <div class="flex items-center bg-slate-900 rounded-xl p-1 border border-slate-800 text-xs font-bold">
            <button onclick="setTimelineStep(0)" id="t-btn-0" class="px-2.5 py-1 rounded-lg bg-cyan-500 text-slate-950 font-black">T+0m</button>
            <button onclick="setTimelineStep(1)" id="t-btn-1" class="px-2.5 py-1 rounded-lg text-slate-400 hover:text-white">T+15m</button>
            <button onclick="setTimelineStep(2)" id="t-btn-2" class="px-2.5 py-1 rounded-lg text-slate-400 hover:text-white">T+30m</button>
            <button onclick="setTimelineStep(3)" id="t-btn-3" class="px-2.5 py-1 rounded-lg text-slate-400 hover:text-white">T+60m</button>
          </div>
        </div>
      </div>

      <!-- CLEAN, ATTRACTIVE VIJAYANAGAR DIGITAL TWIN MAP -->
      <div class="relative card-panel rounded-3xl border border-slate-800/90 shadow-2xl overflow-hidden flex-1 min-h-[540px] flex flex-col bg-slate-950">
        
        <!-- Map Top Badges -->
        <div class="absolute top-4 left-5 z-20 flex items-center gap-2.5 pointer-events-none">
          <div class="px-3 py-1.5 rounded-xl text-xs font-extrabold uppercase tracking-wider bg-slate-900/90 text-cyan-300 border border-slate-700/80 backdrop-blur-md flex items-center gap-2 shadow-xl">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
            Vijayanagar Sector Twin &bull; Bengaluru West
          </div>
          <div id="cascade-alert-pill" class="hidden px-3 py-1.5 rounded-xl text-xs font-extrabold uppercase tracking-wider bg-rose-500/20 text-rose-300 border border-rose-500/40 animate-pulse flex items-center gap-1.5 shadow-xl">
            <i data-lucide="alert-triangle" class="w-4 h-4 text-rose-400"></i>
            Active Domino Ripple
          </div>
        </div>

        <!-- Traffic Speed Indicator -->
        <div class="absolute top-4 right-5 z-20 flex items-center gap-2 bg-slate-900/90 border border-slate-700/80 px-3.5 py-1.5 rounded-xl text-xs backdrop-blur-md shadow-xl">
          <span class="text-slate-400">Traffic:</span>
          <div class="flex items-center gap-1.5">
            <span class="text-[10px] text-slate-500">Fluid</span>
            <div class="w-16 h-2 rounded-full bg-gradient-to-r from-emerald-500 via-amber-400 to-rose-600"></div>
            <span class="text-[10px] text-slate-500">Gridlock</span>
          </div>
          <span id="traffic-legend-status" class="mono text-emerald-400 font-bold ml-1">38 km/h</span>
        </div>

        <!-- CANVAS: VECTOR-SMOOTH VIJAYANAGAR TWIN -->
        <canvas id="twinCanvas" class="w-full h-full flex-1 cursor-pointer block min-h-[500px]"></canvas>

        <!-- Node Inspector Drawer (Bottom Slide-Up) -->
        <div id="node-inspector" class="absolute bottom-0 inset-x-0 bg-slate-950/95 border-t border-slate-800 p-4 transition-all duration-300 backdrop-blur-xl translate-y-full flex flex-col md:flex-row items-start md:items-center justify-between gap-4 z-30">
          <div class="flex items-center gap-3">
            <div id="inspector-badge" class="w-11 h-11 rounded-xl bg-amber-500/20 border border-amber-500/30 flex items-center justify-center text-amber-400 font-bold text-sm">
              PWR
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h4 id="inspector-title" class="font-bold text-slate-100 text-sm">BESCOM Vijayanagar 66/11kV Substation</h4>
                <span id="inspector-status" class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/20 text-amber-300">LOAD: 64%</span>
              </div>
              <p id="inspector-desc" class="text-xs text-slate-400 mt-0.5">Primary power feeder for RPC Layout, West of Chord Road traffic lights, and BWSSB reservoir pumps.</p>
            </div>
          </div>

          <div class="flex items-center gap-6 text-xs">
            <div>
              <span class="text-slate-400 block">Upstream Feed:</span>
              <span id="inspector-upstream" class="font-semibold text-slate-200">KPTCL Peenya 220kV Grid Line</span>
            </div>
            <div>
              <span class="text-slate-400 block">Downstream Cascades:</span>
              <span id="inspector-downstream" class="font-semibold text-rose-400">West of Chord Road, Maruti Mandir, BGS Hospital</span>
            </div>
            <button onclick="closeInspector()" class="p-1.5 rounded-lg hover:bg-slate-800 text-slate-400 hover:text-white cursor-pointer">
              <i data-lucide="x" class="w-4 h-4"></i>
            </button>
          </div>
        </div>

      </div>

      <!-- BOTTOM 4 QUICK VITALS -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5">
        <div class="card-panel p-3.5 rounded-xl border border-slate-800">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs text-slate-400 font-semibold">BESCOM RPC Substation</span>
            <i data-lucide="zap" class="w-4 h-4 text-amber-400"></i>
          </div>
          <div class="flex items-baseline gap-2">
            <span id="metric-power-val" class="mono text-2xl font-bold text-amber-400">64 MW</span>
            <span id="metric-power-pct" class="text-xs text-slate-400">Nominal</span>
          </div>
          <div class="w-full bg-slate-800 h-1.5 rounded-full mt-2 overflow-hidden">
            <div id="metric-power-bar" class="bg-amber-400 h-full rounded-full transition-all duration-500" style="width: 62%"></div>
          </div>
        </div>

        <div class="card-panel p-3.5 rounded-xl border border-slate-800">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs text-slate-400 font-semibold">West of Chord Flow</span>
            <i data-lucide="car" class="w-4 h-4 text-cyan-400"></i>
          </div>
          <div class="flex items-baseline gap-2">
            <span id="metric-traffic-val" class="mono text-2xl font-bold text-cyan-400">38 km/h</span>
            <span id="metric-traffic-pct" class="text-xs text-slate-400">Fluid</span>
          </div>
          <div class="w-full bg-slate-800 h-1.5 rounded-full mt-2 overflow-hidden">
            <div id="metric-traffic-bar" class="bg-cyan-400 h-full rounded-full transition-all duration-500" style="width: 85%"></div>
          </div>
        </div>

        <div class="card-panel p-3.5 rounded-xl border border-slate-800">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs text-slate-400 font-semibold">Vijayanagar GLR Pumping</span>
            <i data-lucide="droplet" class="w-4 h-4 text-emerald-400"></i>
          </div>
          <div class="flex items-baseline gap-2">
            <span id="metric-water-val" class="mono text-2xl font-bold text-emerald-400">92 PSI</span>
            <span id="metric-water-pct" class="text-xs text-slate-400">Nominal</span>
          </div>
          <div class="w-full bg-slate-800 h-1.5 rounded-full mt-2 overflow-hidden">
            <div id="metric-water-bar" class="bg-emerald-400 h-full rounded-full transition-all duration-500" style="width: 92%"></div>
          </div>
        </div>

        <div class="card-panel p-3.5 rounded-xl border border-slate-800">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs text-slate-400 font-semibold">BGS Trauma Corridor</span>
            <i data-lucide="ambulance" class="w-4 h-4 text-rose-400"></i>
          </div>
          <div class="flex items-baseline gap-2">
            <span id="metric-emg-val" class="mono text-2xl font-bold text-rose-400">4.2 min</span>
